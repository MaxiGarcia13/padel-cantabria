---
import Breadcrumb from '@/components/breadcrumb.vue';
import Header from '@/components/header.astro';
import TeamPage from '@/components/team/team-page.vue';
import AppLayout from '@/layouts/app-layout.astro';
import { loadTeamStandingAndNextMatch } from '@padel-cantabria/shared';
import { getDb } from '@/server/db';
import { buildTeamPath, parseCategoryParams, teamCategoryKey, teamMatchesCategory } from '@/routes';
import { teamBreadcrumbItems } from '@/utils/breadcrumb-items';

export const prerender = false;

const categoryKey = parseCategoryParams(Astro.params);
const teamId = Number(Astro.params.id);

if (!categoryKey || !Number.isFinite(teamId)) {
  return Astro.redirect('/');
}

const db = getDb();

const [team, leagues] = await Promise.all([db.getTeamById(teamId), db.getLeagues()]);

if (!team) {
  return Astro.redirect('/');
}

if (!teamMatchesCategory(team, categoryKey)) {
  return Astro.redirect(buildTeamPath(teamCategoryKey(team, categoryKey.phase), teamId));
}

const initialPhases = await db.getTeamPhases(teamId);

if (initialPhases.length > 0 && !initialPhases.includes(categoryKey.phase)) {
  return Astro.redirect(buildTeamPath(teamCategoryKey(team, initialPhases[0]), teamId));
}

const initialSummary = await loadTeamStandingAndNextMatch(db, team, categoryKey.phase, leagues);
const breadcrumbItems = teamBreadcrumbItems(leagues, team, categoryKey.phase);
---

<AppLayout title={`${team.name} · Pádel Cantabria`}>
  <Header
    teamName={team.name}
    league={String(team.league_id)}
    gender={team.gender}
    phase={categoryKey.phase}
    category={team.category}
  />

  <div class="mx-auto flex w-full max-w-6xl flex-col gap-4 p-4" transition:animate="fade">
    <Breadcrumb items={breadcrumbItems} />
    <main>
      <TeamPage
        client:load
        team={team}
        leagues={leagues}
        phase={categoryKey.phase}
        initialPhases={initialPhases}
        initialSummary={initialSummary}
      />
    </main>
  </div>
</AppLayout>
