---
import Breadcrumb from '@/components/breadcrumb.vue';
import Header from '@/components/header.astro';
import MatchesByDate from '@/components/matches/matches-by-date.vue';
import AppLayout from '@/layouts/app-layout.astro';
import { parseCategoryParams } from '@/routes';
import { getDb } from '@/server/db';
import { calendarBreadcrumbItems } from '@/utils/breadcrumb-items';

export const prerender = false;

const categoryKey = parseCategoryParams(Astro.params);

if (!categoryKey) {
  return Astro.redirect('/');
}

const teamParam = Astro.url.searchParams.get('team');
const parsedTeamId = teamParam != null ? Number(teamParam) : undefined;
const teamId = parsedTeamId != null && Number.isFinite(parsedTeamId) ? parsedTeamId : undefined;

const { league, gender, phase, category } = Astro.params;
const leagues = await getDb().getLeagues();
const breadcrumbItems = calendarBreadcrumbItems(leagues, categoryKey);
---

<AppLayout title="Calendario · Pádel Cantabria">
  <Header league={league} gender={gender} phase={phase} category={category} />

  <div class="mx-auto flex w-full max-w-6xl flex-col gap-4 p-4" transition:animate="fade">
    <Breadcrumb items={breadcrumbItems} />
    <main class="flex flex-col gap-6">
      <h1 class="text-lg font-medium text-foreground">Calendario</h1>
      <MatchesByDate client:load category={categoryKey} teamId={teamId} />
    </main>
  </div>
</AppLayout>
