---
import BackButton from '@/components/back-button.vue';
import ClosestMatches from '@/components/matches/closest-matches.vue';
import StandingsTable from '@/components/standings/standings-table.vue';
import Header from '@/components/header.astro';
import AppLayout from '@/layouts/app-layout.astro';
import { buildCategoryPath, parseCategoryParams } from '@/server/load-category-matches';

export const prerender = false;

const categoryKey = parseCategoryParams(Astro.params);

if (!categoryKey) {
  return Astro.redirect('/');
}

const { league, gender, phase, category } = Astro.params;
const calendarHref = `${buildCategoryPath(categoryKey)}/calendar`;
---

<AppLayout title="Resultados · Pádel Cantabria">
  <Header league={league} gender={gender} phase={phase} category={category} />

  <div class="mx-auto flex w-full max-w-6xl flex-col gap-4 p-4" transition:animate="fade">
    <BackButton client:idle />
    <main class="flex flex-col gap-6">
      <div class="flex flex-col gap-4">
        <h2 class="text-lg font-medium text-foreground">Clasificación</h2>
        <StandingsTable client:load category={categoryKey} />
      </div>
      <div class="flex flex-col gap-4">
        <h2 class="text-lg font-medium text-foreground">Próximos partidos</h2>
        <ClosestMatches client:visible category={categoryKey} calendarHref={calendarHref} />
      </div>
    </main>
  </div>
</AppLayout>
