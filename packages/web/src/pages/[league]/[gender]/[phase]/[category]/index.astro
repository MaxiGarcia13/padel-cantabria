---
import ClosestMatches from '@/components/matches/closest-matches.astro';
import Header from '@/components/header.astro';
import { getClosestMatches } from '@/domain/matches';
import AppLayout from '@/layouts/app-layout.astro';
import {
  buildCategoryPath,
  loadCategoryMatches,
  parseCategoryParams,
} from '@/server/load-category-matches';

export const prerender = false;

const categoryKey = parseCategoryParams(Astro.params);

if (!categoryKey) {
  return Astro.redirect('/');
}

const { league, gender, phase, category } = Astro.params;
const { matches, season } = await loadCategoryMatches(categoryKey);
const closestMatches = season
  ? getClosestMatches(matches, season)
  : matches.slice(0, 5);
const calendarHref = `${buildCategoryPath(categoryKey)}/calendario`;
---

<AppLayout title="Resultados · Pádel Cantabria">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-8 p-4">
    <Header league={league} gender={gender} phase={phase} category={category} />

    <main class="flex flex-col gap-6">
      <div class="flex flex-col gap-4">
        <h2 class="text-lg font-medium text-foreground">Clasificación</h2>
        <p class="text-sm text-muted">Próximamente.</p>
      </div>
      <div class="flex flex-col gap-4">
        <h2 class="text-lg font-medium text-foreground">Próximos partidos</h2>
        <ClosestMatches matches={closestMatches} calendarHref={calendarHref} />
      </div>
    </main>
  </div>
</AppLayout>
