---
import { BrandIcon } from './icons';
import { Searcher } from './search';

interface Props {
  league?: string;
  gender?: string;
  phase?: string;
  category?: string;
  teamName?: string;
}

const { league, gender, phase, category, teamName } = Astro.props;
const isCollapsible = Boolean(
  (league && gender && phase && category) || teamName,
);
---

<header class="w-full max-w-6xl rounded-xl border border-border bg-surface p-4" transition:persist="search-header">
  <div class="flex flex-col gap-4">
    <div class="flex items-center gap-2 border-b border-border pb-4">
      <BrandIcon class="size-6 text-foreground" />
      <p class="text-lg font-semibold text-foreground">Liga Cantabria de Pádel</p>
    </div>

    <Searcher
      client:load
      initialLeagueId={league}
      initialGenderValue={gender}
      initialPhaseValue={phase}
      initialCategoryValue={category}
      collapsible={isCollapsible}
    />
  </div>
</header>
