---
import { Searcher } from './search';

interface Props {
  league?: string;
  gender?: string;
  phase?: string;
  category?: string;
}

const { league, gender, phase, category } = Astro.props;
const isCollapsible = Boolean(league && gender && phase && category);
---

<header class="w-full max-w-6xl rounded-xl border border-border bg-surface p-4" transition:persist="search-header">
  <div class="flex flex-col gap-4">
    <div class="border-b border-border pb-4">
      <p class="text-lg font-semibold text-foreground">Pádel Cantabria</p>
    </div>

    <Searcher
      client:load
      initialLeagueId={league}
      initialGenderValue={gender}
      initialPhaseValue={phase}
      initialCategoryValue={category}
      collapsible={isCollapsible}
    />
  </div>
</header>
