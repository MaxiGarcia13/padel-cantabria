---
import { Searcher } from './search';

interface Props {
  league?: string;
  gender?: string;
  phase?: string;
  category?: string;
}

const { league, gender, phase, category } = Astro.props;
---

<header
  class="w-full max-w-6xl rounded-xl border border-border bg-surface p-4"
  transition:name="searcher"
>
  <div class="flex flex-col gap-4">
    <div class="border-b border-border pb-4">
      <p class="text-lg font-semibold text-foreground">
        Pádel Cantabria
      </p>
    </div>

    <Searcher
      client:load
      transition:persist="searcher"
      initialLeagueId={league}
      initialGenderValue={gender}
      initialPhaseValue={phase}
      initialCategoryValue={category}
    />
  </div>
</header>
