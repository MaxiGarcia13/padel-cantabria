---
import type { MatchDateGroup } from '@/domain/matches';
import MatchRow from './match-row.astro';

interface Props {
  groups: MatchDateGroup[];
}

const { groups } = Astro.props;
---

{
  groups.length === 0 ? (
    <p class="text-sm text-muted">No hay partidos disponibles.</p>
  ) : (
    <div class="flex flex-col gap-8">
      {groups.map((group) => (
        <section class="flex flex-col gap-4">
          <h2 class="text-lg font-medium text-foreground">{group.date}</h2>
          <ul class="flex flex-col gap-4">
            {group.matches.map((match) => (
              <li>
                <MatchRow match={match} />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )
}
