---
import type { Match } from '@padel-cantabria/database';
import MatchRow from './match-row.astro';

interface Props {
  matches: Match[];
  calendarHref: string;
}

const { matches, calendarHref } = Astro.props;
---

<div class="flex flex-col gap-4">
  {
    matches.length === 0 ? (
      <p class="text-sm text-muted">No hay partidos disponibles.</p>
    ) : (
      <ul class="flex flex-col gap-4">
        {matches.map((match) => (
          <li>
            <MatchRow match={match} />
          </li>
        ))}
      </ul>
    )
  }

  <a
    href={calendarHref}
    class="text-sm font-medium text-primary hover:underline"
  >
    Ver calendario
  </a>
</div>
