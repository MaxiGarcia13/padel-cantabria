{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "outDir": "./dist",
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
