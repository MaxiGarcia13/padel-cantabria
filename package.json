{
  "name": "@padel-cantabria",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.11.2",
  "description": "",
  "author": "",
  "license": "ISC",
  "keywords": [],
  "main": "index.js",
  "scripts": {
    "lint": "eslint . --ignore-pattern 'packages/web/**' && pnpm -r --if-present run lint",
    "lint:fix": "eslint --fix . --ignore-pattern 'packages/web/**' && pnpm -r --if-present run lint:fix",
    "clean": "rm -rf node_modules dist && pnpm -r run clean",
    "phoenix": "pnpm clean && pnpm install",
    "dev": "pnpm --filter=@padel-cantabria/web dev",

    "scrape:leagues": "pnpm --filter @padel-cantabria/scrapper scrape:leagues",
    "scrape:teams": "pnpm --filter @padel-cantabria/scrapper scrape:teams",
    "scrape:calendar": "pnpm --filter @padel-cantabria/scrapper scrape:calendar"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@maxigarcia/eslint-config": "^1.14.1",
    "@nx/js": "^23.3.0",
    "eslint": "^10.12.0",
    "nx": "^23.3.0"
  }
}
